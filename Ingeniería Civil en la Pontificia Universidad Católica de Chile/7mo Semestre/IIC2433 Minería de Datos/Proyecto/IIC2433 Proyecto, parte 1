ype":"code","execution_count":121,"metadata":{"executionInfo":{"elapsed":5,"status":"ok","timestamp":1782062349610,"user":{"displayName":"Franco Nicolai Corvalán Mansourova","userId":"03669814590806608851"},"user_tz":240},"id":"6luKtz118qV7"},"outputs":[],"source":["df_apriori = df.copy()\n","\n","df_apriori['Tuvo_sepsis']           = (df_apriori['Sepsis tardía - germen primer evento'] != 220).astype(int)\n","df_apriori[\"Días de VM\"]            = df_apriori[\"Días de VM\"].fillna(0)\n","df_apriori[\"Duración oxígeno días\"] = df_apriori[\"Duración oxígeno días\"].fillna(0)\n","df_apriori[\"Sulfato de magnesio\"]   = df_apriori[\"Sulfato de magnesio\"].astype(int)\n","\n","df_apriori[\"Tipo de parto\"] = df_apriori[\"Tipo de parto\"].map({\n","    126: \"Espontáneo\",\n","    127: \"Cesárea sin TP\",\n","    128: \"Cesárea con TP\"\n","})\n","\n","df_apriori[\"Severidad DBP\"] = df_apriori[\"Severidad DBP\"].map({\n","    129: \"Leve\",\n","    130: \"Moderada\",\n","    131: \"Severa\",\n","    132: \"NA\"\n","})\n","\n","df_apriori[\"Destino\"] = df_apriori[\"Destino\"].map({\n","    209: \"Domicilio\",\n","    210: \"Traslado Interno\",\n","    211: \"Otro Hospital\",\n","    212: \"Fallece\"\n","}).fillna(\"Domicilio\")"]},{"cell_type":"markdown","metadata":{"id":"cJAwLJG087jE"},"source":["## Datos apriori\n","\n","Continuamos definiendo las variables que se utilizan para el algoritmo, más otras que necesitamos discretizar para el correcto funcionamiento del algoritmo.\n","\n","Notamos que las variables de seguimiento dependen del sexo del bebe, por lo que no las vamos a utilizar."]},{"cell_type":"code","execution_count":122,"metadata":{"executionInfo":{"elapsed":5,"status":"ok","timestamp":1782062349623,"user":{"displayName":"Franco Nicolai Corvalán Mansourova","userId":"03669814590806608851"},"user_tz":240},"id":"Iadc9SqY84oz","collapsed":true},"outputs":[],"source":["cols_apriori = [\n","    \"Fenton al nacer\",\n","    \"Multiple\",\n","    \"Corticoides prenatales\",\n","    \"Sulfato de magnesio\",\n","    \"Malformación congénita mayor\",\n","    \"Tipo de parto\",\n","    \"Hemorragia Intraventricular (HIV)\",\n","    \"Leucomalacia\",\n","    \"Hidrocefalia\",\n","    \"ECN\",\n","    \"Recibe Surfactante\",\n","    \"O2 36 semanas\",\n","    \"Severidad DBP\",\n","    \"Destino\",\n","    \"O2 domiciliario al alta\",\n","    \"Parálisis cerebral 24 Meses\",\n","    \"cat_socioeducativa\",\n","    \"Estado_Seguimiento\",\n","    \"Tuvo_sepsis\"\n","]\n","\n","df_discretizada = df_apriori[cols_apriori].copy()"]},{"cell_type":"markdown","metadata":{"id":"rHgDEeYI90tX"},"source":["### Discretizar"]},{"cell_type":"code","execution_count":123,"metadata":{"executionInfo":{"elapsed":5,"status":"ok","timestamp":1782062349633,"user":{"displayName":"Franco Nicolai Corvalán Mansourova","userId":"03669814590806608851"},"user_tz":240},"id":"eaO-cxlO91uz"},"outputs":[],"source":["# Discretizar peso al nacer\n","df_discretizada['Cat_Peso_Nacer'] = pd.cut(\n","    df_apriori['Peso al nacer'],\n","    bins=[0, 999.9, 1499.9, np.inf],\n","    labels=['Extremadamente Bajo (<1000g)', 'Muy Bajo (1000-1500g)', 'Favorable (>1500g)']\n",")\n","\n","# Edad de la madre\n","df_discretizada['Cat_Edad_Madre'] = pd.cut(\n","    df_apriori['Edad de la madre'],\n","    bins=[0, 18.9, 35.9, np.inf],\n","    labels=['Adolescente', 'Optima (19-35)', 'Avanzada (>35)']\n",")\n","\n","# Tiempo de estadía\n","df_discretizada['Cat_Estadia'] = pd.qcut(\n","    df_apriori['Días de estadía'],\n","    q=3,\n","    labels=['Estancia Corta', 'Estancia Media', 'Estancia Prolongada']\n",")\n","\n","# Oxígeno\n","mediana_oxigeno_sin_0 = df_apriori[df_apriori['Duración oxígeno días'] > 0]['Duración oxígeno días'].median()\n","\n","condiciones_oxi = [\n","    df_apriori['Duración oxígeno días'] == 0,\n","    df_apriori['Duración oxígeno días'].between(1, mediana_oxigeno_sin_0),\n","    df_apriori['Duración oxígeno días'] > mediana_oxigeno_sin_0\n","]\n","\n","df_discretizada['Cat_Oxigeno'] = np.select(\n","    condiciones_oxi,\n","    ['Sin Oxígeno', 'Uso Corto/Medio', 'Uso Prolongado'],\n","    default=pd.NA\n",")\n","\n","# Ventilación mecánica\n","mediana_VM_sin_0 = df_apriori[df_apriori['Días de VM'] > 0]['Días de VM'].median()\n","\n","condiciones_vm = [\n","    df_apriori['Días de VM'] == 0,\n","    df_apriori['Días de VM'].between(1, mediana_VM_sin_0),\n","    df_apriori['Días de VM'] > mediana_VM_sin_0\n","]\n","\n","df_discretizada['Cat_VM'] = np.select(\n","    condiciones_vm,\n","    ['Sin VM', 'Pocos Días', 'Muchos días'],\n","    default=pd.NA\n",")\n","\n","# Edad Gestacional al Nace\n","df_discretizada['Cat_EG_Nacer'] = pd.cut(\n","    df_apriori['EG al nacer'],\n","    bins=[0, 27.9, 31.9, 40],\n","    labels=['Extremo (<28)', 'Muy Prematuro (28-31)', 'Moderado/Tardío (>=32)']\n",")\n","\n","# Edad Gestacional al Alta\n","df_discretizada['Cat_EG_Alta'] = pd.cut(\n","    df_apriori['EG_Alta'],\n","    bins=[0, 36.9, 40.9, np.inf],\n","    labels=['Alta Temprana (<37s)', 'Alta a Término (37-40s)', 'Alta Retrasada (>40s)']\n",")"]},{"cell_type":"code","execution_count":124,"metadata":{"executionInfo":{"elapsed":5,"status":"ok","timestamp":1782062349643,"user":{"displayName":"Franco Nicolai Corvalán Mansourova","userId":"03669814590806608851"},"user_tz":240},"id":"J4G9ugBXEB5R"},"outputs":[],"source":["col_to_cat = [\"Tipo de parto\", \"Severidad DBP\", \"Destino\", \"cat_socioeducativa\", \"Estado_Seguimiento\", \"Cat_Oxigeno\", \"Cat_VM\"]\n","\n","for col in col_to_cat:\n","    df_discretizada[col] = df_discretizada[col].astype(\"category\")"]},{"cell_type":"markdown","metadata":{"id":"nmInA1X2-IKk"},"source":["### Matriz de \"transacciones\""]},{"cell_type":"code","execution_count":125,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":227},"executionInfo":{"elapsed":26,"status":"ok","timestamp":1782062349676,"user":{"displayName":"Franco Nicolai Corvalán Mansourova","userId":"036698145908066